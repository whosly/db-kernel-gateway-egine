{
  "realm": "gateway",
  "enabled": true,
  "displayName": "Gateway Console Lab",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "CONSOLE_ADMIN",
        "description": "Gateway console administrator",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CONSOLE_VIEWER",
        "description": "Gateway console read-only viewer",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "console-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Console",
      "lastName": "Admin",
      "email": "console-admin@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["CONSOLE_ADMIN"]
    },
    {
      "username": "console-viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Console",
      "lastName": "Viewer",
      "email": "console-viewer@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": ["CONSOLE_VIEWER"]
    }
  ],
  "clients": [
    {
      "clientId": "gateway-console",
      "name": "Gateway Console",
      "description": "Confidential OIDC client for db-kernel-gateway console SSO (lab)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/console",
        "http://127.0.0.1:8080/login/oauth2/code/console"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/console/*##http://127.0.0.1:8080/console/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-nested",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
