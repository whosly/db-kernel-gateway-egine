# Copy to .env and fill before `docker compose up`.
# Lab credentials only — never use these passwords in production.

# 32-byte AES key (Base64) for control-plane password envelope encryption:
#   openssl rand -base64 32
GATEWAY_CONSOLE_SECRET_KEY_BASE64=REPLACE_WITH_openssl_rand_base64_32

# Optional: require Bearer / X-Console-Token on /console/api/**
# GATEWAY_CONSOLE_API_TOKEN=
# Optional read-only console token (GET/HEAD only; writes still need api-token)
# GATEWAY_CONSOLE_READ_TOKEN=

# Lab DB passwords (must match docker-compose + application-docker.yml)
MYSQL_ROOT_PASSWORD=Aa123456.
MYSQL_PASSWORD=Aa123456.
POSTGRES_PASSWORD=Aa123456.
